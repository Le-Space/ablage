    "@helia/unixfs": "^8.0.9",
    "@le-space/aleph-bootstrap": "^0.9.9",
    "@le-space/libp2p-webrtc-qr": "^0.14.0",
    "@libp2p/bootstrap": "^12.0.33",
    "@libp2p/circuit-relay-v2": "^4.2.14",
    "@libp2p/dcutr": "^3.0.29",
    "@libp2p/gossipsub": "^16.1.1",
    "@libp2p/identify": "^4.1.15",
    "@libp2p/peer-id": "^6.0.16",
    "@libp2p/ping": "^3.1.14",
